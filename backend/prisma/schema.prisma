generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String   @default("Guest Buyer")
  email        String?  @unique
  passwordHash String?
  phone        String?  @unique
  role         UserRole @default(BUYER)

  business Business?
  cart     Cart?
  orders   Order[]     @relation("BuyerOrders")
  quotations Quotation[] @relation("BuyerQuotations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  products Product[]
  quotations Quotation[] @relation("BusinessQuotations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  minOrderQuantity Int    @default(1)
  unit             String @default("piece")
  imageUrl    String?
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  isSurplus       Boolean   @default(false)
  surplusQuantity Int       @default(0)
  surplusPrice    Decimal?  @db.Decimal(10, 2)
  surplusDeadline DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  bulkPricing BulkPricing[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  quotations  Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([categoryId])
  @@index([name])
  @@index([isActive, isFeatured])
  @@index([isSurplus])
}

model BulkPricing {
  id String @id @default(uuid())

  minQuantity Int
  maxQuantity Int?
  pricePerUnit Decimal @db.Decimal(10, 2)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                 String      @id @default(uuid())
  orderNumber        String      @unique
  buyerId            String
  buyer              User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  status             String      @default("Confirmed")
  subtotal           Decimal     @db.Decimal(12, 2)
  totalSavings       Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal     @db.Decimal(12, 2)
  totalUnits         Int         @default(1)
  deliveryAddress    Json?
  paymentMethod      String      @default("Trade Credit / RTGS / NEFT")
  notes              String?
  rejectionReason    String?
  cancellationReason String?
  quotationId        String?     @unique
  quotation          Quotation?  @relation("OrderQuotation", fields: [quotationId], references: [id], onDelete: SetNull)
  carrierName        String?
  trackingNumber     String?
  acceptedAt         DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  rejectedAt         DateTime?

  items              OrderItem[]

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(10, 2)
  itemTotal    Decimal  @db.Decimal(12, 2)
  savings      Decimal  @default(0) @db.Decimal(10, 2)
  unit         String   @default("piece")
  businessId   String?
  businessName String?
  quotationId  String?
  activeTier   Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([businessId])
}

model Quotation {
  id                   String             @id @default(uuid())
  quotationNumber      String             @unique
  buyerId              String
  buyer                User               @relation("BuyerQuotations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerBusinessId     String
  sellerBusiness       Business           @relation("BusinessQuotations", fields: [sellerBusinessId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSnapshot      Json?
  buyerInfo            Json?
  status               String             @default("Submitted")
  requestedQuantity    Int
  buyerTargetPrice     Decimal?           @db.Decimal(10, 2)
  deliveryAddress      Json?
  paymentTerms         String?
  requiredByDate       String?
  buyerNotes           String?
  quotedUnitPrice      Decimal?           @db.Decimal(10, 2)
  quotedQuantity       Int?
  quotedTotalAmount    Decimal?           @db.Decimal(12, 2)
  validityDays         Int?               @default(14)
  validUntil           DateTime?
  dispatchTimeline     String?
  freightTerms         String?
  sellerNotes          String?
  rejectionReason      String?
  buyerRejectionReason String?
  isCounterOffer       Boolean            @default(false)
  order                Order?             @relation("OrderQuotation")
  respondedAt          DateTime?
  acceptedAt           DateTime?
  orderedAt            DateTime?

  messages             QuotationMessage[]

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([buyerId])
  @@index([sellerBusinessId])
  @@index([productId])
  @@index([status])
}

model QuotationMessage {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  senderId    String
  senderRole  String
  action      String
  price       Decimal?  @db.Decimal(10, 2)
  quantity    Int?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([quotationId])
}
